  "fixed_sql": [
    {
      "name": "tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"fingerprint\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"artist\" TEXT NOT NULL DEFAULT '', \"album\" TEXT NOT NULL DEFAULT '', \"album_artist\" TEXT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"track_number\" INTEGER NULL, \"disc_number\" INTEGER NULL, \"year\" INTEGER NULL, \"genre\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'local', \"source_url\" TEXT NULL, \"isrc\" TEXT NULL, \"liked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"liked\" IN (0, 1)), \"liked_at\" INTEGER NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_offline\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_offline\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playlist_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_entries\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"playlist_id\" TEXT NOT NULL REFERENCES playlists (id), \"track_id\" TEXT NOT NULL REFERENCES tracks (id), \"position\" REAL NOT NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "play_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"play_events\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"track_id\" TEXT NOT NULL REFERENCES tracks (id), \"played_at\" INTEGER NOT NULL, \"listened_ms\" INTEGER NOT NULL DEFAULT 0, \"device_id\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "library_folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_folders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"added_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "track_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"track_files\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"track_id\" TEXT NOT NULL REFERENCES tracks (id), \"path\" TEXT NOT NULL UNIQUE, \"size_bytes\" INTEGER NOT NULL, \"modified_at\" INTEGER NOT NULL, \"folder_id\" INTEGER NULL REFERENCES library_folders (id) ON DELETE CASCADE);"
        }
      ]
    }
  ]
}